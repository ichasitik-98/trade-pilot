# ============================================================================
# TRADEPILOT — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================================================

# 1. ENVIRONMENT & URL APLIKASI
NODE_ENV="production"
APP_URL="https://nama-project-anda.vercel.app"
APP_TIMEZONE="Asia/Jakarta"

# 2. AUTHENTICATION & SESSION SECRET (SERVER-SIDE ONLY)
# Generate with: openssl rand -hex 32
AUTH_SECRET="f9a4b7e2c1d84e6f93a10b2c5d8e7f4a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e"

# 3. DATABASE NEON POSTGRESQL (PRISMA ORM)
DATABASE_URL="postgresql://user:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 4. MARKET DATA CONFIGURATION (TWELVE DATA REAL MODE - SERVER-SIDE ONLY)
MARKET_DATA_MODE="REAL"
MARKET_DATA_PROVIDER="TWELVEDATA"
MARKET_DATA_API_KEY="YOUR_TWELVEDATA_API_KEY"
MARKET_DATA_API_URL="https://api.twelvedata.com"

# 5. GEMINI AI ANALYST (SERVER-SIDE ONLY)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
