# GEMINI_API_KEY: Required for server-side Gemini AI features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (when connecting to production PostgreSQL/Neon)
DATABASE_URL="postgresql://user:password@host/database"

# MARKET_DATA_MODE: Operating mode ('REAL', 'DEMO', or 'DISABLED')
MARKET_DATA_MODE="DEMO"

# MARKET_DATA_PROVIDER: External provider identifier ('twelvedata', 'alphavantage', etc.)
MARKET_DATA_PROVIDER="twelvedata"

# MARKET_DATA_API_KEY: External provider API key (server-side only, never leaked to client)
MARKET_DATA_API_KEY="MY_MARKET_DATA_API_KEY"

# MARKET_DATA_API_URL: External provider API base URL
MARKET_DATA_API_URL="https://api.twelvedata.com"

# APP_TIMEZONE: Preferred display timezone for timestamps (stored in UTC)
APP_TIMEZONE="Asia/Jakarta"

